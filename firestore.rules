rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "shibbir.ahma.2025@gmail.com");
    }

    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return (userDoc != null && userDoc.data != null) ? userDoc.data : null;
    }

    function getRole(orgId) {
      let data = getUserData();
      return data == null ? null : 
             (data.roles is map && orgId in data.roles) ? data.roles[orgId] :
             (data.get('organizationId', '') == orgId && data.get('role', '') is string) ? data.role :
             null;
    }

    function isAdmin(orgId) {
      let role = getRole(orgId);
      return isSuperAdmin() || (isAuthenticated() && (role == 'admin' || role == 'super_admin'));
    }

    function isTeacher(orgId) {
      let role = getRole(orgId);
      return isSuperAdmin() || (isAuthenticated() && (role == 'admin' || role == 'super_admin' || role == 'teacher'));
    }

    function isViewer(orgId) {
      let role = getRole(orgId);
      return isSuperAdmin() || (isAuthenticated() && (role == 'admin' || role == 'super_admin' || role == 'teacher' || role == 'viewer'));
    }

    function isAssignedTeacher(orgId, classId) {
      let classDoc = get(/databases/$(database)/documents/organizations/$(orgId)/classes/$(classId));
      return classDoc != null && classDoc.data != null && 
             classDoc.data.teacherIds != null && 
             request.auth.uid in classDoc.data.teacherIds;
    }

    function isMember(orgId) {
      return isSuperAdmin() || (isAuthenticated() && (getRole(orgId) != null || (getUserData() != null && getUserData().organizationId == orgId)));
    }

    function isVersionCorrect() {
      return !('version' in resource.data) || 
             (request.resource.data.version == resource.data.version + 1);
    }

    match /{document=**} {
      allow read, write, delete: if isSuperAdmin();
    }

    // Secure user updates:
    // A user can only be updated by:
    // 1. A Super Admin
    // 2. Themselves (self-update)
    // 3. An Org Admin, BUT ONLY IF they are modifying `roles`, `visitedOrgs`, or `organizationId` for their active org.
    function canUpdateUser(userId) {
       let isSelfUpdate = isAuthenticated() && request.auth.uid == userId;
       let callerData = getUserData();
       let callerOrgId = callerData != null ? callerData.get('organizationId', '') : '';
       
       let callerRoles = callerData != null ? callerData.get('roles', {}) : {};
       let callerRole = callerOrgId in callerRoles ? callerRoles[callerOrgId] : (callerData != null ? callerData.get('role', '') : '');
       let isCallerAdmin = callerRole == 'admin';
       
       let diff = request.resource.data.diff(resource.data);
       let onlyAllowedKeys = diff.affectedKeys().hasOnly(['roles', 'organizationId', 'visitedOrgs']);
       
       let oldRoles = resource.data.get('roles', {});
       let newRoles = request.resource.data.get('roles', {});
       let validRolesUpdate = !('roles' in diff.affectedKeys()) || newRoles.diff(oldRoles).affectedKeys().hasOnly([callerOrgId]);
       
       let oldVisited = resource.data.get('visitedOrgs', {});
       let newVisited = request.resource.data.get('visitedOrgs', {});
       let validVisitedUpdate = !('visitedOrgs' in diff.affectedKeys()) || newVisited.diff(oldVisited).affectedKeys().hasOnly([callerOrgId]);
       
       return isSuperAdmin() || 
              isSelfUpdate || 
              (callerData != null && callerOrgId != '' && isCallerAdmin && onlyAllowedKeys && validRolesUpdate && validVisitedUpdate);
    }

    match /users/{userId} {
      // Org admins need to read users associated with their orgs to approve them
      allow read: if isSuperAdmin() || isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if canUpdateUser(userId);
      allow delete: if isSuperAdmin();
      allow list: if isSuperAdmin() || isAuthenticated();
    }

    match /organizations/{orgId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin(orgId);
      allow delete: if isSuperAdmin();

      match /academic_years/{yearId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /classes/{classId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /exams/{examId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /subjects/{subjectId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /students/{studentId} {
        allow read: if true;
        allow create: if isAdmin(orgId) || isAssignedTeacher(orgId, request.resource.data.classId);
        allow update: if isAdmin(orgId) || isAssignedTeacher(orgId, resource.data.classId);
        allow delete: if isAdmin(orgId) || isAssignedTeacher(orgId, resource.data.classId);
      }
      match /results/{resultId} {
        allow read: if isTeacher(orgId) || resource.data.status == 'published';
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId) && isVersionCorrect();
        allow delete: if isAdmin(orgId);
      }
      match /attendance_sessions/{sessionId} {
        allow read: if isViewer(orgId);
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId) && (isVersionCorrect() || isAdmin(orgId));
        allow delete: if isAdmin(orgId);
      }
      match /leaves/{leaveId} {
        allow read: if isViewer(orgId);
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId);
        allow delete: if isAdmin(orgId);
      }
      match /holidays/{holidayId} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }
      match /{document=**} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }
    }
    
    match /globalSettings/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /feeCategories/{categoryId} {
      allow read: if isSuperAdmin() || (resource != null && isMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (request.resource != null && isAdmin(request.resource.data.orgId));
      allow update, delete: if isSuperAdmin() || (resource != null && isAdmin(resource.data.orgId));
    }

    match /feeSetups/{setupId} {
      allow read: if isSuperAdmin() || (resource != null && isMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (request.resource != null && isAdmin(request.resource.data.orgId));
      allow update, delete: if isSuperAdmin() || (resource != null && isAdmin(resource.data.orgId));
    }

    match /feeCollections/{collectionId} {
      allow read: if isSuperAdmin() || (resource != null && isMember(resource.data.orgId));
      allow create: if isSuperAdmin() || (request.resource != null && isTeacher(request.resource.data.orgId));
      allow update, delete: if isSuperAdmin() || (resource != null && isTeacher(resource.data.orgId));
    }

    match /counters/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
