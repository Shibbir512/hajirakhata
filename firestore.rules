rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole(orgId) {
      return getUserData().roles[orgId];
    }

    function isAdmin(orgId) {
      return isAuthenticated() && getRole(orgId) == 'admin';
    }

    function isTeacher(orgId) {
      return isAuthenticated() && (getRole(orgId) == 'admin' || getRole(orgId) == 'teacher');
    }

    function isViewer(orgId) {
      return isAuthenticated() && (getRole(orgId) == 'admin' || getRole(orgId) == 'teacher' || getRole(orgId) == 'viewer');
    }

    function isMember(orgId) {
      return isAuthenticated() && getUserData().roles.keys().hasAny([orgId]);
    }

    function isVersionCorrect() {
      return !('version' in resource.data) || 
             (request.resource.data.version == resource.data.version + 1);
    }

    match /organizations/{orgId} {
      allow get: if true;
      allow list: if true;

      match /academic_years/{yearId} {
        allow read: if true;
      }
      match /classes/{classId} {
        allow read: if true;
      }
      match /exams/{examId} {
        allow read: if true;
      }
      match /subjects/{subjectId} {
        allow read: if true;
      }
      match /students/{studentId} {
        allow read: if true;
      }
      match /results/{resultId} {
        allow read: if isTeacher(orgId) || (resource.data.status == 'published');
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId) && isVersionCorrect();
        allow delete: if isAdmin(orgId);
      }
      match /attendance_sessions/{sessionId} {
        allow read: if isViewer(orgId);
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId) && isVersionCorrect();
        allow delete: if isAdmin(orgId);
      }
      match /{document=**} {
        allow read, write: if isMember(orgId);
      }
    }
    
    match /globalSettings/{document=**} {
      allow read: if true;
    }
  }
}
