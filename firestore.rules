rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "shibbir.ahma.2025@gmail.com");
    }

    function getUserData() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return (userDoc != null && userDoc.data != null) ? userDoc.data : null;
    }

    function getRole(orgId) {
      let data = getUserData();
      return data == null ? null : 
             (data.roles is map && orgId in data.roles) ? data.roles[orgId] :
             (data.get('organizationId', '') == orgId && data.get('role', '') is string) ? data.role :
             null;
    }

    function isAdmin(orgId) {
      let role = getRole(orgId);
      return isSuperAdmin() || (isAuthenticated() && (role == 'admin' || role == 'super_admin'));
    }

    function isTeacher(orgId) {
      let role = getRole(orgId);
      return isSuperAdmin() || (isAuthenticated() && (role == 'admin' || role == 'super_admin' || role == 'teacher'));
    }

    function isViewer(orgId) {
      let role = getRole(orgId);
      return isSuperAdmin() || (isAuthenticated() && (role == 'admin' || role == 'super_admin' || role == 'teacher' || role == 'viewer'));
    }

    function isAssignedTeacher(orgId, classId) {
      let classDoc = get(/databases/$(database)/documents/organizations/$(orgId)/classes/$(classId));
      return classDoc != null && classDoc.data != null && 
             classDoc.data.teacherIds != null && 
             request.auth.uid in classDoc.data.teacherIds;
    }

    function isMember(orgId) {
      return isSuperAdmin() || (isAuthenticated() && (getRole(orgId) != null || (getUserData() != null && getUserData().organizationId == orgId)));
    }

    function isVersionCorrect() {
      return !('version' in resource.data) || 
             (request.resource.data.version == resource.data.version + 1);
    }

    match /{document=**} {
      allow read, write, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (request.auth.uid == userId || (resource != null && isAdmin(resource.data.organizationId))));
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isSuperAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isSuperAdmin();
      allow list: if isSuperAdmin() || isAuthenticated(); // We rely on the query filter and read rules
    }

    match /organizations/{orgId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin(orgId);
      allow delete: if isSuperAdmin();

      match /academic_years/{yearId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /classes/{classId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /exams/{examId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /subjects/{subjectId} {
        allow read: if true;
        allow write: if isAdmin(orgId);
      }
      match /students/{studentId} {
        allow read: if true;
        allow create: if isAdmin(orgId) || isAssignedTeacher(orgId, request.resource.data.classId);
        allow update: if isAdmin(orgId) || isAssignedTeacher(orgId, resource.data.classId);
        allow delete: if isAdmin(orgId) || isAssignedTeacher(orgId, resource.data.classId);
      }
      match /results/{resultId} {
        allow read: if isTeacher(orgId) || resource.data.status == 'published';
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId) && isVersionCorrect();
        allow delete: if isAdmin(orgId);
      }
      match /attendance_sessions/{sessionId} {
        allow read: if isViewer(orgId);
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId) && isVersionCorrect();
        allow delete: if isAdmin(orgId);
      }
      match /leaves/{leaveId} {
        allow read: if isViewer(orgId);
        allow create: if isTeacher(orgId);
        allow update: if isTeacher(orgId);
        allow delete: if isAdmin(orgId);
      }
      match /{document=**} {
        allow read: if isMember(orgId);
        allow write: if isAdmin(orgId);
      }
    }
    
    match /globalSettings/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /counters/{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
